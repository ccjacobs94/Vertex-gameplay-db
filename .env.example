# ============================================================================
# Game Hub Configuration (.env)
# ============================================================================

# How often (in hours) to automatically sync Steam, Xbox, and PSN in the background
SYNC_INTERVAL_HOURS=6

# ----------------------------------------------------------------------------
# 1. STEAM (PC)
# Get your API Key: https://steamcommunity.com/dev/apikey
# STEAM_ID can be your 17-digit SteamID64 OR your custom profile vanity name
# (Note: Make sure "Game details" is set to Public in Steam Privacy Settings)
# ----------------------------------------------------------------------------
STEAM_API_KEY=
STEAM_ID=

# ----------------------------------------------------------------------------
# 2. XBOX & PC GAME PASS (via OpenXBL)
# Sign in with your Xbox account at https://xbl.io/ and copy your free API Key
# ----------------------------------------------------------------------------
XBL_API_KEY=

# ----------------------------------------------------------------------------
# 3. PLAYSTATION 4 / 5 (PSN)
# 1. Log into https://www.playstation.com/ in your browser
# 2. In the same browser tab, visit: https://ca.account.sony.com/api/v1/ssocookie
# 3. Paste the 64-character "npsso" value below
# ----------------------------------------------------------------------------
PSN_NPSSO=

# ----------------------------------------------------------------------------
# 4. OPTIONAL: RAWG API Key (for extra metadata/genre enrichment)
# Note: Cover art & game catalog search already works WITHOUT any key!
# ----------------------------------------------------------------------------
RAWG_API_KEY=

# ----------------------------------------------------------------------------
# 5. OPTIONAL: Remote MCP Server, OAuth 2.1 & Cloudflare Tunnel
# Required only if exposing the MCP server publicly (e.g., for Gemini Web / Claude).
# Generate a strong secret with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ----------------------------------------------------------------------------
MCP_PORT=8096
MCP_PUBLIC_DOMAIN=http://localhost:8096
MCP_CLIENT_ID=game-hub-mcp
MCP_CLIENT_SECRET=

# Set COMPOSE_PROFILES=tunnel and provide TUNNEL_TOKEN to enable the cloudflared sidecar
COMPOSE_PROFILES=
TUNNEL_TOKEN=

# ----------------------------------------------------------------------------
# 6. WEB UI AUTHENTICATION (Vertex Login for https://vertex.crjacobs.cc)
# When VERTEX_REQUIRE_AUTH=true and VERTEX_PASSWORD (or MCP_CLIENT_SECRET) is set,
# the Web UI requires login and issues a 90-day session cookie.
# Set VERTEX_AUTH_BYPASS_LOCAL=true if you want direct LAN/Tailscale HTTP visits
# to skip the login screen while still enforcing login on your public domain.
# ----------------------------------------------------------------------------
VERTEX_REQUIRE_AUTH=true
VERTEX_USERNAME=chameleon94
VERTEX_PASSWORD=
VERTEX_AUTH_BYPASS_LOCAL=true

# ----------------------------------------------------------------------------
# 7. HOMELAB USER PERMISSIONS (PUID / PGID)
# User ID (PUID) and Group ID (PGID) to run container processes as and own /app/data
# ----------------------------------------------------------------------------
PUID=1000
PGID=1000

# ----------------------------------------------------------------------------
# 8. EDITION, REGISTRATION & HOSTED BILLING
# VERTEX_EDITION: "selfhosted" (default) or "hosted" (SaaS monthly subscription mode)
# VERTEX_REGISTRATION: Default registration policy for self-hosted instances:
#   "disabled" (default), "invite" (requires invite code), "approval" (pending admin review), "open"
# VERTEX_ENV_PASSWORD_FALLBACK: true to allow legacy bootstrap env password fallback
# Stripe configuration (required only when VERTEX_EDITION=hosted):
# ----------------------------------------------------------------------------
VERTEX_EDITION=selfhosted
VERTEX_REGISTRATION=disabled
VERTEX_ENV_PASSWORD_FALLBACK=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ----------------------------------------------------------------------------
# 9. QA & VALIDATION CONTAINER (develop branch)
# Exposed on Tailscale / LAN for QA review
# ----------------------------------------------------------------------------
QA_PORT=8098
QA_MCP_PORT=8099

# ----------------------------------------------------------------------------
# 10. STORAGE ARCHITECTURE & DISK OFF-LOADING (HDD Storage Pool)
# Offload user databases, system database, backups, and caches from SSD to HDD.
# Leave empty to use default repository local directories (./data, ./data-qa).
# ----------------------------------------------------------------------------
GAMEHUB_DATA_PATH=/mnt/storage-pool/game-hub/data
GAMEHUB_QA_DATA_PATH=/mnt/storage-pool/game-hub/data-qa
GAMEHUB_BACKUP_PATH=/mnt/storage-pool/game-hub/backups
GAMEHUB_CACHE_PATH=/mnt/storage-pool/game-hub/cache
GAMEHUB_BACKUP_KEEP=15
